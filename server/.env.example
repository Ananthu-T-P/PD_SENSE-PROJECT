# PD-SENSE backend environment — copy to .env and fill in. NEVER commit .env.
# The service-role key is the ONLY privileged credential and it lives here,
# server-side ONLY. It must never appear in the browser bundle or firmware.

# HTTP server
PORT=3000
# Comma-separated allowed origins for the dashboards (reflect = LAN demo).
# For file:// dashboards the Origin header is "null" and is always allowed.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Supabase (Project Settings -> API) — SERVICE ROLE key, backend only
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# Browser dashboards authenticate with this shared bearer token.
# If unset, the API runs in OPEN DEMO MODE (a loud warning is logged).
DASHBOARD_TOKEN=change-me-dashboard-token

# Device registry bootstrap. The devices TABLE is the source of truth; seeds
# here are upserted at startup so a fresh deployment has one known device.
# Format: deviceId:token:patientId[, deviceId2:token2:patientId2]
DEVICE_SEED=pd-sense-01:CHANGE_ME_DEVICE_TOKEN:P-001

# Freshness thresholds (ms) for LIVE / STALE / OFFLINE classification
FRESH_ONLINE_MS=45000
FRESH_STALE_MS=120000

# Backend-owned alert evaluation
ALERT_PROLONGED_FREEZE_MS=8000
ALERT_HIGH_TREMOR_SCORE=6.5
ALERT_HIGH_TREMOR_CONSEC=3
ALERT_COOLDOWN_MS=600000
